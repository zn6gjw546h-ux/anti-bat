local LOGO_FILE = "ZenvyxAntiBat_Logo.png"
local LOGO_B64 = ""
local function loadLogoAsset()
	local asset = nil
	pcall(function()
		local data = nil
		if type(base64decode) == "function" then
			data = base64decode(LOGO_B64)
		else
			local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
			local raw = LOGO_B64:gsub("[^"..alphabet.."=]", "")
			local out = {}
			for i = 1, #raw, 4 do
				local function idx(c)
					if c == "=" or c == "" then return 0 end
					return (alphabet:find(c, 1, true) or 1) - 1
				end
				local a,b,c,d = idx(raw:sub(i,i)), idx(raw:sub(i+1,i+1)), idx(raw:sub(i+2,i+2)), idx(raw:sub(i+3,i+3))
				local n = a*262144 + b*4096 + c*64 + d
				local x = math.floor(n/65536)%256
				local y = math.floor(n/256)%256
				local z = n%256
				if raw:sub(i+2,i+2) == "=" then out[#out+1] = string.char(x)
				elseif raw:sub(i+3,i+3) == "=" then out[#out+1] = string.char(x,y)
				else out[#out+1] = string.char(x,y,z) end
			end
			data = table.concat(out)
		end
		if writefile and data then writefile(LOGO_FILE, data) end
		local getter = getcustomasset or getsynasset
		if type(getter) == "function" and isfile and isfile(LOGO_FILE) then
			asset = getter(LOGO_FILE)
		end
	end)
	return asset
end
